   "outputs": [],
   "source": [
    "def check_site_structure():\n",
    "    \"\"\"Проверка текущей структуры сайта\"\"\"\n",
    "    \n",
    "    print(\"🔍 ПРОВЕРКА СТРУКТУРЫ САЙТА:\")\n",
    "    print(\"=\" * 40)\n",
    "    \n",
    "    test_url = \"https://lifehacker.ru/category/technology/\"\n",
    "    \n",
    "    try:\n",
    "        response = requests.get(test_url, timeout=10)\n",
    "        soup = BeautifulSoup(response.text, 'html.parser')\n",
    "        \n",
    "        print(f\"\\n✅ Сайт доступен: {response.status_code}\")\n",
    "        \n",
    "        # Ищем различные элементы\n",
    "        print(\"\\n🔎 ПОИСК ЭЛЕМЕНТОВ:\")\n",
    "        \n",
    "        # Поиск статей\n",
    "        articles = soup.find_all('article')\n",
    "        print(f\"Теги <article>: {len(articles)}\")\n",
    "        \n",
    "        # Поиск ссылок\n",
    "        links = soup.find_all('a', href=True)\n",
    "        tech_links = [l for l in links if '/technology/' in l['href']]\n",
    "        print(f\"Ссылки с '/technology/': {len(tech_links)}\")\n",
    "        \n",
    "        # Поиск заголовков\n",
    "        h1_tags = soup.find_all('h1')\n",
    "        h2_tags = soup.find_all('h2')\n",
    "        print(f\"Теги <h1>: {len(h1_tags)}\")\n",
    "        print(f\"Теги <h2>: {len(h2_tags)}\")\n",
    "        \n",
    "        if len(articles) > 0:\n",
    "            print(\"\\n📌 ПРИМЕР СТРУКТУРЫ ПЕРВОЙ СТАТЬИ:\")\n",
    "            first_article = articles[0]\n",
    "            \n",
    "            # Классы первого article\n",
    "            if first_article.get('class'):\n",
    "                print(f\"Классы article: {first_article['class']}\")\n",
    "            \n",
    "            # Поиск ссылки в первой статье\n",
    "            article_link = first_article.find('a', href=True)\n",
    "            if article_link:\n",
    "                print(f\"Ссылка: {article_link['href']}\")\n",
    "                if article_link.get('class'):\n",
    "                    print(f\"Классы ссылки: {article_link['class']}\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Ошибка при проверке: {e}\")\n",
    "\n",
    "# Запускаем проверку\n",
    "check_site_structure()"
   ]
