    "    \n",
    "    print(\"\\n📊 СТАТИСТИКА ПО ДЛИНЕ СТАТЕЙ:\")\n",
    "    print(df[['text_length', 'word_count']].describe().to_string())\n",
    "    \n",
    "    print(\"\\n📈 РАСПРЕДЕЛЕНИЕ ПО ДЛИНЕ:\")\n",
    "    bins = [0, 1000, 2000, 3000, 4000, 5000, 100000]\n",
    "    labels = ['<1K', '1K-2K', '2K-3K', '3K-4K', '4K-5K', '>5K']\n",
    "    df['length_category'] = pd.cut(df['text_length'], bins=bins, labels=labels)\n",
    "    print(df['length_category'].value_counts().sort_index())\n",
    "    \n",
    "    print(\"\\n🔤 САМЫЕ ДЛИННЫЕ СТАТЬИ:\")\n",
    "    longest = df.nlargest(3, 'text_length')[['title', 'text_length', 'word_count']]\n",
    "    for i, row in longest.iterrows():\n",
    "        print(f\"   {row['title'][:50]}...: {row['text_length']} символов, {row['word_count']} слов\")\n",
    "    \n",
    "    print(\"\\n🔤 САМЫЕ КОРОТКИЕ СТАТЬИ:\")\n",
    "    shortest = df.nsmallest(3, 'text_length')[['title', 'text_length', 'word_count']]\n",
    "    for i, row in shortest.iterrows():\n",
    "        print(f\"   {row['title'][:50]}...: {row['text_length']} символов, {row['word_count']} слов\")\n",
    "else:\n",
    "    print(\"❌ Нет данных для анализа\")"
   ]
