    "def export_to_formats(df, base_name='lifehacker_articles'):\n",
    "    \"\"\"Экспорт данных в различные форматы\"\"\"\n",
    "    \n",
    "    formats = {\n",
    "        'csv': {'engine': None, 'ext': '.csv'},\n",
    "        'json': {'orient': 'records', 'ext': '.json'},\n",
    "        'html': {'ext': '.html'},\n",
    "        'pickle': {'ext': '.pkl'}\n",
    "    }\n",
    "    \n",
    "    print(\"💾 ЭКСПОРТ ДАННЫХ:\")\n",
    "    print(\"-\" * 40)\n",
    "    \n",
    "    # CSV\n",
    "    csv_file = f\"{base_name}.csv\"\n",
    "    df.to_csv(csv_file, index=False, encoding='utf-8-sig')\n",
    "    print(f\"✅ CSV: {csv_file}\")\n",
    "    \n",
    "    # JSON\n",
    "    json_file = f\"{base_name}.json\"\n",
    "    df.to_json(json_file, orient='records', force_ascii=False, indent=2)\n",
    "    print(f\"✅ JSON: {json_file}\")\n",
    "    \n",
    "    # HTML\n",
    "    html_file = f\"{base_name}.html\"\n",
    "    df.head(20).to_html(html_file, index=False, encoding='utf-8')\n",
    "    print(f\"✅ HTML: {html_file}\")\n",
    "    \n",
    "    # TXT (только заголовки)\n",
    "    txt_file = f\"{base_name}_titles.txt\"\n",
    "    with open(txt_file, 'w', encoding='utf-8') as f:\n",
    "        for title in df['title']:\n",
    "            f.write(title + '\\n\\n')\n",
    "    print(f\"✅ TXT (заголовки): {txt_file}\")\n",
    "\n",
    "if len(df) > 0:\n",
    "    export_to_formats(df)\n",
    "else:\n",
    "    print(\"❌ Нет данных для экспорта\")"
   ]
  },
