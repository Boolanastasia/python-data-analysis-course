   "source": [
    "# 🌐 ПАРСИНГ РУБРИКИ 'ТЕХНОЛОГИИ' С LIFEHACKER.RU\n",
    "## Сбор заголовков и текстов статей\n",
    "\n",
    "**Автор:**\n",
    "\n",
    "**Дата:**\n",
    "\n",
    "**Описание:** Парсинг статей из рубрики Технологии с сайта lifehacker.ru"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. ИМПОРТ БИБЛИОТЕК"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Импортируем необходимые библиотеки\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "import pandas as pd\n",
    "from tqdm import tqdm\n",
    "import time\n",
    "import os\n",
    "\n",
    "print(\"✅ Библиотеки успешно импортированы\")\n",
    "print(f\"📚 Версии библиотек:\")\n",
    "print(f\"   requests: {requests.__version__}\")\n",
    "print(f\"   pandas: {pd.__version__}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. ОСНОВНАЯ ФУНКЦИЯ ПАРСЕРА"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def parse_lifehacker_articles(pages=10):\n",
    "    \"\"\"\n",
    "    Парсит заголовки и тексты материалов из рубрики Технологии с lifehacker.ru\n",
    "    \n",
    "    Parameters:\n",
    "    pages (int): количество страниц для парсинга (по умолчанию 10)\n",
    "    \n",
    "    Returns:\n",
    "    pd.DataFrame: датафрейм с колонками title, text, url\n",
    "    \"\"\"\n",
    "    # Базовый URL рубрики Технологии\n",
    "    base_url = \"https://lifehacker.ru/category/technology/page/\"\n",
    "    \n",
    "    articles_data = []\n",
    "    \n",
    "    print(f\"🔍 Парсим первые {pages} страниц рубрики Технологии...\")\n",
    "    \n",
    "    # Парсим первые N страниц\n",
    "    for page_num in tqdm(range(1, pages + 1), desc=\"Страницы\"):\n",
    "        try:\n",
    "            # Формируем URL страницы\n",
    "            if page_num == 1:\n",
    "                page_url = \"https://lifehacker.ru/category/technology/\"\n",
    "            else:\n",
    "                page_url = f\"{base_url}{page_num}/\"\n",
    "            \n",
    "            # Добавляем задержку между запросами\n",
    "            time.sleep(1)\n",
    "            \n",
    "            # Получаем HTML страницы\n",
    "            headers = {\n",
    "                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'\n",
    "            }\n",
    "            response = requests.get(page_url, headers=headers, timeout=10)\n",
    "            response.raise_for_status()\n",
    "            \n",
    "            soup = BeautifulSoup(response.text, 'html.parser')\n",
    "            \n",
    "            # Находим ссылки на статьи на текущей странице\n",
    "            # Пробуем разные селекторы для поиска статей\n",
    "            article_cards = []\n",
    "            \n",
    "            # Вариант 1: поиск по тегу article\n",
    "            article_cards = soup.find_all('article')\n",
    "            \n",
    "            # Если не нашли, пробуем другие селекторы\n",
    "            if not article_cards:\n",
    "                article_cards = soup.find_all('div', class_=lambda x: x and ('post' in x or 'article' in x))\n",
    "            \n",
    "            for card in article_cards:\n",
    "                # Ищем ссылки внутри карточки\n",
    "                link_tag = card.find('a', href=True)\n",
    "                if link_tag and 'href' in link_tag.attrs:\n",
    "                    article_url = link_tag['href']\n",
    "                    \n",
    "                    # Фильтруем ссылки на статьи\n",
    "                    if article_url and '/technology/' in article_url and not article_url.endswith('/page/'):\n",
    "                        # Добавляем базовый URL, если ссылка относительная\n",
    "                        if article_url.startswith('/'):\n",
    "                            article_url = \"https://lifehacker.ru\" + article_url\n",
    "                        \n",
    "                        articles_data.append({'url': article_url})\n",
    "        \n",
    "        except requests.RequestException as e:\n",
    "            print(f\"❌ Ошибка при загрузке страницы {page_num}: {e}\")\n",
    "            continue\n",
    "    \n",
    "    # Удаляем дубликаты URL\n",
    "    unique_articles = []\n",
    "    seen_urls = set()\n",
    "    for article in articles_data:\n",
    "        if article['url'] not in seen_urls:\n",
    "            seen_urls.add(article['url'])\n",
    "            unique_articles.append(article)\n",
    "    \n",
    "    print(f\"\\n📊 Найдено уникальных статей: {len(unique_articles)}\")\n",
    "    \n",
    "    # Парсим каждую статью\n",
    "    print(\"\\n📝 Парсим содержимое статей...\")\n",
    "    for i, article in enumerate(tqdm(unique_articles, desc=\"Статьи\")):\n",
    "        try:\n",
    "            # Добавляем задержку между запросами\n",
    "            time.sleep(0.5)\n",
    "            \n",
    "            # Получаем HTML код статьи\n",
    "            headers = {\n",
    "                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'\n",
    "            }\n",
    "            response = requests.get(article['url'], headers=headers, timeout=10)\n",
    "            response.raise_for_status()\n",
    "            \n",
    "            article_soup = BeautifulSoup(response.text, 'html.parser')\n",
    "            \n",
    "            # Извлекаем заголовок статьи\n",
    "            title = None\n",
    "            \n",
    "            # Пробуем разные селекторы для заголовка\n",
    "            title_selectors = [\n",
    "                ('h1', {'class': 'article-header__title'}),\n",
    "                ('h1', {'class': 'post-title'}),\n",
    "                ('h1', {'class': 'entry-title'}),\n",
    "                ('h1', {}),  # любой h1\n",
    "                ('title', {})  # тег title\n",
    "            ]\n",
    "            \n",
    "            for tag, attrs in title_selectors:\n",
    "                title_tag = article_soup.find(tag, attrs)\n",
    "                if title_tag:\n",
    "                    title = title_tag.get_text(strip=True)\n",
    "                    break\n",
    "            \n",
    "            article['title'] = title if title else \"Заголовок не найден\"\n",
    "            \n",
    "            # Извлекаем текст статьи\n",
    "            text = None\n",
    "            \n",
    "            # Пробуем разные селекторы для контента\n",
    "            content_selectors = [\n",
    "                ('div', {'class': 'article-content'}),\n",
    "                ('div', {'class': 'post-content'}),\n",
    "                ('div', {'class': 'entry-content'}),\n",
    "                ('article', {}),\n",
    "                ('div', {'class': 'content'})\n",
    "            ]\n",
    "            \n",
    "            for tag, attrs in content_selectors:\n",
    "                content_div = article_soup.find(tag, attrs)\n",
    "                if content_div:\n",
    "                    # Удаляем ненужные элементы\n",
    "                    for unwanted in content_div(['script', 'style', 'aside', 'nav', 'header', 'footer', 'iframe']):\n",
    "                        unwanted.decompose()\n",
    "                    \n",
    "                    # Извлекаем все параграфы\n",
    "                    paragraphs = content_div.find_all('p')\n",
    "                    if paragraphs:\n",
    "                        text = ' '.join([p.get_text(strip=True) for p in paragraphs])\n",
    "                    else:\n",
    "                        text = content_div.get_text(separator=' ', strip=True)\n",
    "                    break\n",
    "            \n",
    "            article['text'] = text if text else \"Текст не найден\"\n",
    "        \n",
    "        except requests.RequestException as e:\n",
    "            print(f\"\\n❌ Ошибка при загрузке статьи {article['url']}: {e}\")\n",
    "            article['title'] = \"Ошибка загрузки\"\n",
    "            article['text'] = \"Ошибка загрузки\"\n",
    "            continue\n",
    "    \n",
    "    # Создаем датафрейм\n",
    "    df = pd.DataFrame(unique_articles)\n",
    "    \n",
    "    # Фильтруем строки с ошибками\n",
    "    if len(df) > 0:\n",
    "        df = df[~df['title'].str.contains('Ошибка|не найден', na=False)]\n",
    "        df = df[~df['text'].str.contains('Ошибка|не найден', na=False)]\n",
    "        \n",
    "        # Удаляем дубликаты\n",
    "        df = df.drop_duplicates(subset=['url', 'title'])\n",
    "        \n",
    "        # Сбрасываем индекс\n",
    "        df = df.reset_index(drop=True)\n",
    "    \n",
    "    return df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. ЗАПУСК ПАРСЕРА"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=\" * 60)\n",
    "print(\"🚀 ЗАПУСК ПАРСЕРА РУБРИКИ 'ТЕХНОЛОГИИ'\")\n",
