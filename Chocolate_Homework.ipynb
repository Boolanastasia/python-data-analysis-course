# 1. Определение класса Chocolate
class Chocolate:
    def __init__(self, price: float, additive: str = None):
        """
        Инициализация шоколадного батончика
        
        Параметры:
        price (float): цена батончика (должна быть > 0)
        additive (str, optional): добавка к шоколаду
        """
        # Проверка, что цена больше нуля
        if price <= 0:
            raise ValueError("Цена должна быть больше нуля")
        
        self.price = price
        self.additive = additive
    
    def show_my_chocolate(self):
        """Выводит информацию о батончике в зависимости от наличия добавки"""
        if self.additive:
            print(f"Шоколадный батончик, добавка: {self.additive}")
        else:
            print("Обычный шоколадный батончик")
    
    def __str__(self):
        """Строковое представление объекта при использовании print()"""
        return f"Шоколадный батончик, {self.price} рублей"

# 2. Демонстрация работы класса
print("=== Демонстрация работы класса Chocolate ===\n")

# Создание обычного батончика без добавки
print("1. Создание обычного батончика:")
chocolate1 = Chocolate(85.50)
print(chocolate1)  # Используем __str__
chocolate1.show_my_chocolate()
print()

# Создание батончика с добавкой
print("2. Создание батончика с добавкой:")
chocolate2 = Chocolate(120.0, "орехи")
print(chocolate2)
chocolate2.show_my_chocolate()
print()

# Создание батончика с другой добавкой
print("3. Создание батончика с другой добавкой:")
chocolate3 = Chocolate(95.30, "изюм")
print(chocolate3)
chocolate3.show_my_chocolate()
print()

# Попытка создать батончик с отрицательной ценой (вызовет исключение)
print("4. Попытка создать батончик с отрицательной ценой:")
try:
    chocolate_error = Chocolate(-50.0)
except ValueError as e:
    print(f"Ошибка: {e}")
