# Дополнительная демонстрация
print("5. Создание нескольких батончиков и вывод в цикле:")
chocolates = [
    Chocolate(75.0, "кокос"),
    Chocolate(80.0),  # Без добавки
    Chocolate(150.0, "миндаль")
]

for i, choco in enumerate(chocolates, 1):
    print(f"Батончик {i}: {choco}")
    choco.show_my_chocolate()
    print()

